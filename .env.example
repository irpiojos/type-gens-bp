# Shared password gate (username is always "historian")
SITE_PASSWORD=historian

# Session signing secret (generate a long random string for production)
AUTH_SECRET=dev-ttm-secret-change-me-in-production

# Optional: Neon Postgres connection string for production on Vercel.
# If unset, the app uses a local PGlite database in .data/ (fine for local/dev).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional: Vercel Blob for avatar uploads later
# BLOB_READ_WRITE_TOKEN=